# Токен бота от @BotFather (/newbot)
BOT_TOKEN=

# Telegram ID администраторов через запятую. Узнать свой: написать боту /id
ADMIN_IDS=

# Необязательно. Пусто — оплата идёт в тестовом режиме (кнопка «Оплатить (тест)», деньги не списываются).
# Токен тестового провайдера: @BotFather → /mybots → бот → Payments → выбрать провайдера → Test.
PAYMENT_PROVIDER_TOKEN=

